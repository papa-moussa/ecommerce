# =====================================================
# PRODUCTION ENV — template for 87.106.171.35
# Rename this to .env.prod on your server
# =====================================================

# PostgreSQL
POSTGRES_USER=ecom_prod
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=ecommerce_prod

# Redis
REDIS_PASSWORD=generate_a_strong_redis_password_here

# URLs (Internes pour Docker)
DATABASE_URL=postgresql://ecom_prod:password_above@postgres:5432/ecommerce_prod?schema=public
REDIS_URL=redis://:redis_password_above@redis:6379

# JWT Secrets (Generate long random strings)
JWT_ACCESS_SECRET=generate_a_very_long_random_string_here_min_32_chars
JWT_REFRESH_SECRET=generate_another_very_long_random_string_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (Production keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP / Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
SMTP_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_...

# Cloudinary
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Algolia
ALGOLIA_APP_ID=...
ALGOLIA_API_KEY=...
ALGOLIA_SEARCH_KEY=...

# Logging
LOG_LEVEL=info
