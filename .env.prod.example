# =====================================================
# PRODUCTION ENV — template (SEC-021: server address moved to Doppler)
# Rename this to .env.prod on your server
# =====================================================

# PostgreSQL
POSTGRES_USER=ecom_prod
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=ecommerce_prod

# Redis
REDIS_PASSWORD=generate_a_strong_redis_password_here

# URLs (Internes pour Docker)
DATABASE_URL=postgresql://ecom_prod:password_above@postgres:5432/ecommerce_prod?schema=public
REDIS_URL=redis://:redis_password_above@redis:6379

# JWT — RS256 key pair (SEC-022)
# Generate with: openssl genrsa 2048 > private.pem && openssl rsa -in private.pem -pubout > public.pem
# Store PEM content with literal \n replacing real newlines (Doppler handles this automatically)
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMII...\n-----END PUBLIC KEY-----
# JWT_ACCESS_SECRET is deprecated (SEC-022) — kept empty for backward compat
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=generate_another_very_long_random_string_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (Production keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP / Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
SMTP_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_...

# Cloudinary
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Algolia
ALGOLIA_APP_ID=...
ALGOLIA_API_KEY=...
ALGOLIA_SEARCH_KEY=...

# Logging
LOG_LEVEL=info
