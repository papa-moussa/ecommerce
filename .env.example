# PostgreSQL
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_dev_password
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Mailhog (dev mail server)
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
