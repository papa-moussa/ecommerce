# =====================================================
# API — Environment variables template
# Copy to apps/api/.env for local development.
# In production, inject via Doppler: `doppler run -- pnpm start`
# NEVER commit real values — use Doppler or GitHub Secrets.
# =====================================================

# App
NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3002
APP_URL=http://localhost:3002

# PostgreSQL
DATABASE_URL=postgresql://ecom:ecom_dev_password@localhost:5434/ecommerce?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — use `openssl rand -hex 32` to generate secrets
JWT_ACCESS_SECRET=change_me_access_min_32_characters_long____
JWT_REFRESH_SECRET=change_me_refresh_min_32_characters_long___
# SEC-002: JWT_TEMP_SECRET MUST be different from JWT_ACCESS_SECRET
# This secret signs the 2FA temp token (twofa: true). A separate secret
# ensures that a temp token cannot be used as a full access token.
JWT_TEMP_SECRET=change_me_temp_min_32_characters_long______
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# SMTP (Mailhog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@maisonparfum.local
RESEND_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Algolia
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_SEARCH_KEY=

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Chatbase
CHATBASE_SYNC_SECRET=

# Logging
LOG_LEVEL=debug

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
