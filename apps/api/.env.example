# App
NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (shared with root .env)
DATABASE_URL=postgresql://ecom:ecom_dev_password@localhost:5432/ecommerce?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (Sprint 1 — placeholders valides pour que le boot passe)
JWT_ACCESS_SECRET=change_me_access_min_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
